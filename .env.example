# アプリの秘密鍵（本番ではランダムな長い文字列に変更してください）
SECRET_KEY=change-me-to-a-random-secret-key

# JWTトークンの有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLiteデータベースのパス
# ローカル: sqlite:///./data/inventory.db
# Render（永続ディスク）: sqlite:////data/inventory.db
DATABASE_URL=sqlite:///./data/inventory.db

# Anthropic Claude API（在庫分析用）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your-api-key-here
# 使用するClaudeモデル
# claude-sonnet-4-20250514 はアカウントによって利用不可の場合あり（自動で代替モデルに切替）
ANTHROPIC_MODEL=claude-sonnet-4-20250514
